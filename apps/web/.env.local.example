NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CVR Elasticsearch (company discovery) — required for "Find virksomheder".
# Free system-to-system login from cvrselvbetjening@erst.dk. Same values as
# services/worker/.env. CVR_ES_URL is optional (defaults to the distribution endpoint).
CVR_ES_USER=
CVR_ES_PASSWORD=
CVR_ES_URL=

# Sonorous OS (PM system) sync — dialer outcomes create/update leads in its CRM.
# Optional: without these the sync no-ops. URL is the PM project's Supabase URL
# (https://mrexjooigorziheilsla.supabase.co); the key is a secret/service-role
# key from that project's dashboard (server-only, never NEXT_PUBLIC).
PM_SUPABASE_URL=
PM_SUPABASE_SECRET_KEY=
